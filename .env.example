# Configure only in the server environment; never use VITE_ prefixes for credentials.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TOOL_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional alternative: set AI_PROVIDER=glm and supply a working Z.ai API key.
GLM_API_KEY=
GLM_MODEL=glm-5.1
GLM_TOOL_MODEL=glm-5-turbo
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
MODEL_TIMEOUT_MS=40000
